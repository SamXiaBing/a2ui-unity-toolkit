/* =============================================================================
 * Crafted.uss — A2UI「打磨皮肤」（Crafted）
 * -----------------------------------------------------------------------------
 * 规则：组件只从 Tokens.uss 的语义变量取值，不散点写 rgb。
 * 这样换肤（切 token 变体）只改变量，组件样式零改动。
 *
 * 中文字体：项目 Resources 已内置 MiSans 的 TMP 字体资产（Regular/Medium/Demibold
 * 三档 SDF，位于 Assets/Resources/Theme/Base/TMP/）。根节点用 Regular 作基础中文，
 * 标题用 Medium/Demibold 体现字重层次（见文末「中文字重层次」规则）。无需新建资源。
 * ========================================================================== */

/* 根节点：原 bug 是 color:rgb(255,0,0)+font-size:36px，会让未单独设色的元素继承
   红字大字号。改为 sane 的继承默认值（深浅主题都覆盖，不会出问题）。 */
.a2ui-skin--crafted {
  color: var(--a2ui-color-onSurface, #1C1B1F);
  font-size: 20px;
  -unity-font-style: normal;
  /* 中文字体 MiSans 由 PanelSettings.fontAsset 统一提供（见 PanelSettings.asset），
   * 此处不在 USS 写 -unity-font-definition：resource() 写法在本引擎会导致样式读取器崩溃。 */
}

/* ---- 容器 / 列表 ----
 * 本引擎的 UI Toolkit（Unity 2022.3 团结分支）不支持 box-shadow 和 gap，
 * 间距改用「直接子元素 margin」模拟。另外 Mapper 给 Column 组件挂的是
 * .a2ui-column（不是 .a2ui-col），两处都覆盖。
 * 关键：UITK/Yoga 的 flex-shrink 默认是 0（CSS 是 1），子元素不会收缩，
 * 长文本/输入框会把卡片撑破。min-width:0 + flex-shrink:1 让子元素可收缩换行。 */
.a2ui-row {
  flex-direction: row;
  align-items: center;
}
.a2ui-row > * { margin-right: var(--a2ui-space-2, 16px); min-width: 0; flex-shrink: 1; }
.a2ui-row > .a2ui-last-child { margin-right: 0; }

.a2ui-col, .a2ui-column {
  flex-direction: column;
}
.a2ui-col > *, .a2ui-column > * { margin-bottom: var(--a2ui-space-2, 16px); min-width: 0; flex-shrink: 1; }
.a2ui-col > .a2ui-last-child, .a2ui-column > .a2ui-last-child { margin-bottom: 0; }

/* List 是 ScrollView，子项在 contentContainer（后代）里，用后代选择器加间距 */
.a2ui-list .a2ui-node { margin-bottom: var(--a2ui-space-1, 8px); }
.a2ui-list__item {
  background-color: var(--a2ui-color-surface, #FFFBFE);
  border-radius: var(--a2ui-radius-sm, 8px);
  padding: var(--a2ui-space-2, 16px);
  margin-bottom: var(--a2ui-space-1, 8px);
  border-left-width: 4px;
  border-left-color: var(--a2ui-color-primary, #6750A4);
  border-left-style: solid;
}
.a2ui-list__item.a2ui-last-child { margin-bottom: 0; }

/* ---- 卡片 ---- */
.a2ui-card {
  background-color: var(--a2ui-color-surface, #FFFBFE);
  border-radius: var(--a2ui-radius-lg, 16px);
  padding: var(--a2ui-space-3, 24px);
  /* 引擎不支持 box-shadow，用 2px 描边 + 底部偏移模拟卡片阴影层次 */
  border-width: 1px;
  border-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-style: solid;
  border-bottom-width: 3px;
  border-bottom-color: var(--a2ui-color-outline, #79747E);
  /* 卡片内放不下的内容裁剪，不许流到卡片外 */
  overflow: hidden;
  min-width: 0;
}
.a2ui-card__title {
  color: var(--a2ui-color-onSurface, #1C1B1F);
  font-size: 30px;
  margin-bottom: var(--a2ui-space-1, 8px);
  -unity-font-style: bold;
}
.a2ui-card__subtitle {
  color: var(--a2ui-color-onSurfaceVariant, #49454F);
  font-size: 20px;
  margin-bottom: var(--a2ui-space-2, 16px);
}
.a2ui-card__body { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 20px; }

/* ---- 文本 ---- */
.a2ui-text {
  color: var(--a2ui-color-onSurface, #1C1B1F);
  font-size: 20px;
  white-space: normal;
  word-wrap: break-word;
  min-width: 0;
  flex-shrink: 1;
}
.a2ui-text--h1 { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 44px; -unity-font-style: bold; }
.a2ui-text--h2 { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 36px; -unity-font-style: bold; }
.a2ui-text--h3 { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 30px; -unity-font-style: bold; }
.a2ui-text--h4 { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 24px; -unity-font-style: bold; }
.a2ui-text--h5 { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 19px; -unity-font-style: bold; }
.a2ui-text--caption { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 15px; }

/* ---- 中文字重层次（暂挂起） ----
 * 标题要更重字重（M3 风格）本应由 MiSans-Demibold / Medium 承担，但 -unity-font-definition
 * 在本引擎用 resource() 会崩溃、用 url() 待验证。先用 PanelSettings.fontAsset（Regular）保底，
 * 字重层次待稳定后再以 url() 形式接回。 */

/* ---- 图标 ---- */
.a2ui-icon {
  width: 40px;
  height: 40px;
  color: var(--a2ui-color-onSurfaceVariant, #49454F);
  -unity-text-align: middle-center;
  font-size: 30px;
}
.a2ui-icon--lg { width: 64px; height: 64px; font-size: 48px; }
.a2ui-icon__fallback { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 30px; -unity-text-align: middle-center; }

/* ---- 图片 ---- */
.a2ui-image {
  width: 100%;
  height: auto;
  border-radius: var(--a2ui-radius-md, 12px);
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
}
.a2ui-image__caption {
  color: var(--a2ui-color-onSurfaceVariant, #49454F);
  font-size: 15px;
  margin-top: var(--a2ui-space-1, 8px);
  -unity-text-align: middle-center;
}

/* ---- 按钮 ---- */
.a2ui-btn {
  padding: var(--a2ui-space-2, 16px) var(--a2ui-space-3, 24px);
  border-radius: var(--a2ui-radius-pill, 999px);
  font-size: 20px;
  -unity-text-align: middle-center;
  border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0;
}
.a2ui-btn:hover { }
.a2ui-btn:active { }
.a2ui-btn--primary {
  background-color: var(--a2ui-color-primary, #6750A4);
  color: var(--a2ui-color-onPrimary, #FFFFFF);
}
.a2ui-btn--secondary {
  background-color: var(--a2ui-color-secondaryContainer, #E8DEF8);
  color: var(--a2ui-color-onSecondaryContainer, #1D192B);
}

/* ---- 分隔线 ---- */
.a2ui-divider { background-color: var(--a2ui-color-outlineVariant, #CAC4D0); }
.a2ui-divider--horizontal { height: 1px; width: 100%; margin: var(--a2ui-space-2, 16px) 0; }
.a2ui-divider--vertical { width: 1px; height: 24px; margin: 0 var(--a2ui-space-2, 16px); }

/* ---- Chips ---- */
.a2ui-chips { flex-direction: row; flex-wrap: wrap; }
.a2ui-chip {
  margin: 0 var(--a2ui-space-1, 8px) var(--a2ui-space-1, 8px) 0;
  padding: var(--a2ui-space-1, 8px) var(--a2ui-space-2, 16px);
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  color: var(--a2ui-color-onSurface, #1C1B1F);
  border-radius: var(--a2ui-radius-pill, 999px);
  font-size: 15px;
  -unity-text-align: middle-center;
  border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0;
}
.a2ui-chip:checked,
.a2ui-chip:focus {
  background-color: var(--a2ui-color-primary, #6750A4);
  color: var(--a2ui-color-onPrimary, #FFFFFF);
}

/* ---- Checkbox（卡片式，带大点击区） ---- */
.a2ui-checkbox-wrap {
  flex-direction: row;
  align-items: center;
  padding: var(--a2ui-space-2, 16px);
  border-radius: var(--a2ui-radius-md, 12px);
  background-color: var(--a2ui-color-surface, #FFFBFE);
}
.a2ui-checkbox-wrap > * { margin-right: var(--a2ui-space-2, 16px); }
.a2ui-checkbox-wrap > .a2ui-last-child { margin-right: 0; }
.a2ui-checkbox {
  width: 36px;
  height: 36px;
  border-radius: var(--a2ui-radius-sm, 8px);
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px;
  border-top-color: var(--a2ui-color-outline, #79747E);
  border-bottom-color: var(--a2ui-color-outline, #79747E);
  border-left-color: var(--a2ui-color-outline, #79747E);
  border-right-color: var(--a2ui-color-outline, #79747E);
}
.a2ui-checkbox:checked {
  background-color: var(--a2ui-color-primary, #6750A4);
  border-top-color: var(--a2ui-color-primary, #6750A4);
  border-bottom-color: var(--a2ui-color-primary, #6750A4);
  border-left-color: var(--a2ui-color-primary, #6750A4);
  border-right-color: var(--a2ui-color-primary, #6750A4);
}
.a2ui-checkbox__heading { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 20px; -unity-font-style: bold; }
.a2ui-checkbox__state { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 15px; }

/* 勾选盒旁的独立文字标签（结构化拆分后不再塞进 Toggle 内部 label） */
.a2ui-checkbox__label {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
  -unity-text-align: middle-left;
}

/* Unity 内部控件默认样式在 20px 中文字体下高度不足（VCRAMP 回归）：
 * 输入框高度放开，行高交给字体度量 */
.a2ui-textfield > .unity-base-text-field__input {
  height: auto;
  min-height: 33px;
}

/* ---- Slider ---- */
.a2ui-slider { height: 40px; }
.a2ui-slider .unity-base-slider__tracker {
  background-color: var(--a2ui-color-primary, #6750A4);
  border-radius: var(--a2ui-radius-pill, 999px);
}
.a2ui-slider .unity-base-slider__dragger {
  background-color: var(--a2ui-color-primary, #6750A4);
  border-radius: var(--a2ui-radius-pill, 999px);
}

/* ---- Tabs ---- */
.a2ui-tabs > * { margin-bottom: var(--a2ui-space-1, 8px); }
.a2ui-tabs > .a2ui-last-child { margin-bottom: 0; }
.a2ui-tabs__header {
  flex-direction: row;
  border-bottom-width: 1px;
  border-bottom-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-bottom-style: solid;
  padding-bottom: var(--a2ui-space-1, 8px);
}
.a2ui-tabs__header > * { margin-right: var(--a2ui-space-1, 8px); min-width: 0; flex-shrink: 1; }
.a2ui-tabs__header > .a2ui-last-child { margin-right: 0; }
.a2ui-tabs__tab {
  padding: var(--a2ui-space-1, 8px) var(--a2ui-space-2, 16px);
  border-radius: var(--a2ui-radius-sm, 8px);
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  color: var(--a2ui-color-onSurface, #1C1B1F);
  font-size: 15px;
  -unity-text-align: middle-center;
}
.a2ui-tabs__tab.a2ui-tabs__tab--active {
  background-color: var(--a2ui-color-primary, #6750A4);
  color: var(--a2ui-color-onPrimary, #FFFFFF);
}

/* ---- Choice（多选筛选） ---- */
.a2ui-choice > * { margin-bottom: var(--a2ui-space-1, 8px); }
.a2ui-choice > .a2ui-last-child { margin-bottom: 0; }
/* 选项挂载点（chips=横排环绕 / checkbox=竖排）内部也加间距 */
.a2ui-choice__options > * { margin: 0 var(--a2ui-space-1, 8px) var(--a2ui-space-1, 8px) 0; }
.a2ui-choice__chip {
  padding: var(--a2ui-space-1, 8px) var(--a2ui-space-2, 16px);
  border-radius: var(--a2ui-radius-pill, 999px);
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  color: var(--a2ui-color-onSurface, #1C1B1F);
  font-size: 15px;
  -unity-text-align: middle-center;
}
.a2ui-choice__chip:checked {
  background-color: var(--a2ui-color-primary, #6750A4);
  color: var(--a2ui-color-onPrimary, #FFFFFF);
}
.a2ui-choice__filter { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 15px; }
.a2ui-choice__limit { color: var(--a2ui-color-error, #B3261E); font-size: 15px; -unity-font-style: bold; }

/* ---- Video / Audio ---- */
.a2ui-video {
  background-color: var(--a2ui-color-inverseSurface, #322F35);
  border-radius: var(--a2ui-radius-md, 12px);
  padding: var(--a2ui-space-2, 16px);
}
.a2ui-video__title { color: var(--a2ui-color-inverseOnSurface, #E6E1E5); font-size: 20px; -unity-font-style: bold; }
.a2ui-video__url { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 15px; }
.a2ui-audio {
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  border-radius: var(--a2ui-radius-md, 12px);
  padding: var(--a2ui-space-2, 16px);
}
.a2ui-audio__title { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 20px; -unity-font-style: bold; }
.a2ui-audio__url { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 15px; }

/* ---- Textfield ---- */
.a2ui-textfield {
  background-color: var(--a2ui-color-surface, #FFFBFE);
  border-radius: var(--a2ui-radius-sm, 8px);
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-bottom-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-left-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-right-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  padding: var(--a2ui-space-2, 16px);
  font-size: 20px;
  color: var(--a2ui-color-onSurface, #1C1B1F);
  /* 输入框可收缩 + 裁剪超长值，不许把卡片撑破 */
  min-width: 0;
  flex-shrink: 1;
  overflow: hidden;
}
/* 字段 label 保底宽度：避免被挤成 0 宽消失（「备注」变不可见的问题） */
.a2ui-textfield .unity-base-field__label,
.a2ui-datetime .unity-base-field__label {
  min-width: 56px;
  flex-shrink: 0;
  white-space: normal;
}
.a2ui-textfield .unity-base-field__input {
  min-width: 0;
  flex-shrink: 1;
  overflow: hidden;
}
.a2ui-textfield--invalid {
  border-top-color: var(--a2ui-color-error, #B3261E);
  border-bottom-color: var(--a2ui-color-error, #B3261E);
  border-left-color: var(--a2ui-color-error, #B3261E);
  border-right-color: var(--a2ui-color-error, #B3261E);
}
.a2ui-textfield__validation { color: var(--a2ui-color-error, #B3261E); font-size: 15px; margin-top: 4px; }

/* ---- DateTime ---- */
.a2ui-datetime {
  background-color: var(--a2ui-color-surfaceContainer, #F3EDF7);
  border-radius: var(--a2ui-radius-md, 12px);
  padding: var(--a2ui-space-2, 16px);
  color: var(--a2ui-color-onSurface, #1C1B1F);
  font-size: 20px;
  -unity-text-align: middle-center;
  min-width: 0;
  flex-shrink: 1;
  overflow: hidden;
}

/* ---- Cabin（休息舱媒体卡） ---- */
.a2ui-cabin {
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  border-radius: var(--a2ui-radius-lg, 16px);
  padding: var(--a2ui-space-3, 24px);
}
.a2ui-cabin--media { flex-direction: row; align-items: center; }
.a2ui-cabin--media > * { margin-right: var(--a2ui-space-2, 16px); }
.a2ui-cabin--media > .a2ui-last-child { margin-right: 0; }
.a2ui-cabin--rest { flex-direction: column; }
.a2ui-cabin--rest > * { margin-bottom: var(--a2ui-space-1, 8px); }
.a2ui-cabin--rest > .a2ui-last-child { margin-bottom: 0; }
/* Mapper 给 ClimateStep 挂的是 .a2ui-cabin--climate（之前漏了样式），在此补齐 */
.a2ui-cabin--climate {
  flex-direction: column;
  background-color: var(--a2ui-color-surface, #FFFBFE);
  border-radius: var(--a2ui-radius-lg, 16px);
  padding: var(--a2ui-space-2, 16px);
  border-width: 1px;
  border-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-style: solid;
}
.a2ui-cabin--climate > * { margin-bottom: var(--a2ui-space-2, 16px); }
.a2ui-cabin--climate > .a2ui-last-child { margin-bottom: 0; }
.a2ui-cabin__tag {
  align-self: flex-start;
  background-color: var(--a2ui-color-primary, #6750A4);
  color: var(--a2ui-color-onPrimary, #FFFFFF);
  border-radius: var(--a2ui-radius-pill, 999px);
  padding: 4px var(--a2ui-space-2, 16px);
  font-size: 15px;
  -unity-text-align: middle-center;
}
.a2ui-cabin__title { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 24px; -unity-font-style: bold; }
.a2ui-cabin__body { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 20px; }
.a2ui-cabin__status { color: var(--a2ui-color-onSurfaceVariant, #49454F); font-size: 15px; }
.a2ui-cabin__play {
  background-color: var(--a2ui-color-primary, #6750A4);
  color: var(--a2ui-color-onPrimary, #FFFFFF);
  border-radius: var(--a2ui-radius-pill, 999px);
  padding: var(--a2ui-space-2, 16px) var(--a2ui-space-3, 24px);
  font-size: 20px;
  -unity-text-align: middle-center;
  align-self: flex-end;
}
.a2ui-cabin__cover { width: 120px; height: 120px; border-radius: var(--a2ui-radius-md, 12px); background-color: var(--a2ui-color-surfaceContainer, #F3EDF7); }

/* ---- Placeholder / Skeleton / Degrade ---- */
.a2ui-placeholder {
  border-radius: var(--a2ui-radius-md, 12px);
  border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px;
  border-top-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-bottom-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-left-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-right-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-top-style: dashed; border-bottom-style: dashed; border-left-style: dashed; border-right-style: dashed;
  padding: var(--a2ui-space-3, 24px);
  color: var(--a2ui-color-onSurfaceVariant, #49454F);
  -unity-text-align: middle-center;
}
.a2ui-skeleton {
  background-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-radius: var(--a2ui-radius-sm, 8px);
}
.a2ui-degrade {
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  border-radius: var(--a2ui-radius-md, 12px);
  padding: var(--a2ui-space-2, 16px);
  color: var(--a2ui-color-onSurfaceVariant, #49454F);
  -unity-text-align: middle-center;
}

/* ---- Modal ---- */
.a2ui-modal__backdrop { background-color: rgba(0,0,0,0.45); }
.a2ui-modal__content {
  background-color: var(--a2ui-color-surface, #FFFBFE);
  border-radius: var(--a2ui-radius-lg, 16px);
  padding: var(--a2ui-space-3, 24px);
  border-width: 1px;
  border-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-style: solid;
  color: var(--a2ui-color-onSurface, #1C1B1F);
}

/* ---- 通用 token 徽标 ---- */
.a2ui-token-badge {
  background-color: var(--a2ui-color-secondaryContainer, #E8DEF8);
  color: var(--a2ui-color-onSecondaryContainer, #1D192B);
  border-radius: var(--a2ui-radius-pill, 999px);
  padding: 4px var(--a2ui-space-2, 16px);
  font-size: 15px;
  -unity-text-align: middle-center;
}

/* ---- 媒体迷你条 ---- */
.a2ui-media {
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  border-radius: var(--a2ui-radius-md, 12px);
  padding: var(--a2ui-space-1, 8px) var(--a2ui-space-2, 16px);
  flex-direction: row;
  align-items: center;
}
.a2ui-media > * { margin-right: var(--a2ui-space-2, 16px); }
.a2ui-media > .a2ui-last-child { margin-right: 0; }
.a2ui-media__title { color: var(--a2ui-color-onSurface, #1C1B1F); font-size: 20px; }

/* ---- 气候 / 休息控件外壳 ---- */
.a2ui-climate, .a2ui-rest {
  background-color: var(--a2ui-color-surface, #FFFBFE);
  border-radius: var(--a2ui-radius-lg, 16px);
  padding: var(--a2ui-space-2, 16px);
  border-width: 1px;
  border-color: var(--a2ui-color-outlineVariant, #CAC4D0);
  border-style: solid;
}

/* ---- Toggle / Checkbox 控件皮肤（MultipleChoice 实际挂的 class） ---- */
.a2ui-choice__option .unity-toggle__input {
  width: 24px;
  height: 24px;
  border-radius: var(--a2ui-radius-sm, 8px);
  background-color: var(--a2ui-color-surfaceVariant, #E7E0EC);
  border-top-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px;
  border-top-color: var(--a2ui-color-outline, #79747E);
  border-bottom-color: var(--a2ui-color-outline, #79747E);
  border-left-color: var(--a2ui-color-outline, #79747E);
  border-right-color: var(--a2ui-color-outline, #79747E);
  margin-right: var(--a2ui-space-1, 8px);
}
.a2ui-choice__option .unity-toggle__input:checked {
  background-color: var(--a2ui-color-primary, #6750A4);
  border-top-color: var(--a2ui-color-primary, #6750A4);
  border-bottom-color: var(--a2ui-color-primary, #6750A4);
  border-left-color: var(--a2ui-color-primary, #6750A4);
  border-right-color: var(--a2ui-color-primary, #6750A4);
}
.a2ui-choice__option .unity-toggle__label,
.a2ui-choice__option .unity-label {
  color: var(--a2ui-color-onSurface, #1C1B1F);
  font-size: 20px;
}
.a2ui-choice__option {
  padding: var(--a2ui-space-1, 8px) 0;
}
