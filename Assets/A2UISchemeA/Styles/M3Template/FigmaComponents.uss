/* =============================================================================
 * FigmaComponents.uss — 由 Figma 设计稿节点数据自动生成（精确转换）
 * 作用域：.a2ui-skin--figma-m3template
 * 按钮高度=48px 圆角=24px 输入框高度=48px 容器间距=16px
 * ========================================================================== */

/* 覆盖层容器布局由 Host.uss 统一管理，a2ui-skin--figma-m3template 不覆盖 width/margin。 */

.a2ui-skin--figma-m3template .a2ui-overlay-card__inner {
  align-items: stretch;
  background-color: #FFFBFE;
  border-radius: 20px;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #CAC4D0; border-bottom-color: #CAC4D0;
  border-left-color: #CAC4D0; border-right-color: #CAC4D0;
  padding: 24px 24px;
}

.a2ui-skin--figma-m3template {
  color: #1C1B1F;
  font-size: 20px;
  -unity-font-style: normal;
}

.a2ui-skin--figma-m3template .a2ui-row { flex-direction: row; align-items: center; }
.a2ui-skin--figma-m3template .a2ui-row > * { margin-right: 16px; }
.a2ui-skin--figma-m3template .a2ui-row > .a2ui-last-child { margin-right: 0; }

.a2ui-skin--figma-m3template .a2ui-col,
.a2ui-skin--figma-m3template .a2ui-column { flex-direction: column; align-items: stretch; width: 100%; }
.a2ui-skin--figma-m3template .a2ui-col > *,
.a2ui-skin--figma-m3template .a2ui-column > * { margin-bottom: 16px; flex-shrink: 0; }
.a2ui-skin--figma-m3template .a2ui-col > .a2ui-last-child,
.a2ui-skin--figma-m3template .a2ui-column > .a2ui-last-child { margin-bottom: 0; }

.a2ui-skin--figma-m3template .a2ui-btn {
  width: 100%; min-height: 48px;
  padding: 12px 24px;
  border-radius: 24px;
  font-size: 20px; -unity-text-align: middle-center;
  border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0;
  flex-shrink: 0;
}
.a2ui-skin--figma-m3template .a2ui-btn--primary { background-color: #6750A4; color: #FFFFFF; -unity-font-style: bold; }
.a2ui-skin--figma-m3template .a2ui-btn--secondary { background-color: #E8DEF8; color: #1D192B; }

.a2ui-skin--figma-m3template .a2ui-textfield,
.a2ui-skin--figma-m3template .a2ui-textfield.unity-text-field {
  flex-direction: column; align-items: stretch; width: 100%;
  min-height: 48px;
  background-color: #FFFBFE;
  border-radius: 8px;
  border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px;
  border-top-color: #CAC4D0; border-bottom-color: #CAC4D0;
  border-left-color: #CAC4D0; border-right-color: #CAC4D0;
  padding: 12px 16px; font-size: 20px; color: #1C1B1F; flex-shrink: 0;
}
.a2ui-skin--figma-m3template .a2ui-textfield > .unity-text-field__label,
.a2ui-skin--figma-m3template .a2ui-textfield.unity-text-field > .unity-text-field__label {
  width: 100%; align-self: flex-start; margin-bottom: 4px; margin-top: 0; padding: 0;
  color: #49454F; font-size: 20px; -unity-font-style: normal;
}
.a2ui-skin--figma-m3template .a2ui-textfield > .unity-text-field__input,
.a2ui-skin--figma-m3template .a2ui-textfield.unity-text-field > .unity-text-field__input {
  width: 100%; align-self: stretch; background-color: transparent;
  border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0;
  color: #1C1B1F; font-size: 20px; padding: 0;
}

.a2ui-skin--figma-m3template .a2ui-text { color: #1C1B1F; font-size: 20px; white-space: normal; }
.a2ui-skin--figma-m3template .a2ui-text--display { color: #1C1B1F; font-size: 44px; -unity-font-style: bold; }
.a2ui-skin--figma-m3template .a2ui-text--h1 { color: #1C1B1F; font-size: 44px; -unity-font-style: bold; }
.a2ui-skin--figma-m3template .a2ui-text--h2 { color: #1C1B1F; font-size: 36px; -unity-font-style: bold; }
.a2ui-skin--figma-m3template .a2ui-text--h3 { color: #1C1B1F; font-size: 30px; -unity-font-style: bold; }
.a2ui-skin--figma-m3template .a2ui-text--h4 { color: #1C1B1F; font-size: 24px; -unity-font-style: bold; }
.a2ui-skin--figma-m3template .a2ui-text--h5 { color: #1C1B1F; font-size: 16px; -unity-font-style: bold; }
.a2ui-skin--figma-m3template .a2ui-text--body { color: #1C1B1F; font-size: 20px; }
.a2ui-skin--figma-m3template .a2ui-text--caption { color: #49454F; font-size: 15px; }

.a2ui-skin--figma-m3template .a2ui-btn--secondary .a2ui-text { color: #6750A4; }

.a2ui-skin--figma-m3template .a2ui-divider { background-color: #CAC4D0; }
.a2ui-skin--figma-m3template .a2ui-divider--horizontal { height: 1px; width: 100%; margin: 16px 0; flex-shrink: 0; }

.a2ui-skin--figma-m3template .a2ui-card {
  background-color: #FFFBFE; border-radius: 16px;
  border-width: 1px; border-color: #CAC4D0; border-style: solid;
}

.a2ui-skin--figma-m3template .a2ui-icon { width: 36px; height: 36px; color: #49454F; -unity-text-align: middle-center; font-size: 28px; }

.a2ui-skin--figma-m3template .a2ui-image { width: 100%; height: 180px; border-radius: 8px; background-color: #E7E0EC; }

.a2ui-skin--figma-m3template .a2ui-slider { height: 40px; }
.a2ui-skin--figma-m3template .a2ui-slider .unity-base-slider__tracker { background-color: #CAC4D0; border-radius: 8px; }
.a2ui-skin--figma-m3template .a2ui-slider .unity-base-slider__dragger { background-color: #6750A4; border-radius: 8px; }
.a2ui-skin--figma-m3template .a2ui-tabs__header { flex-direction: row; border-bottom-width: 1px; border-bottom-color: #CAC4D0; padding-bottom: 8px; }
.a2ui-skin--figma-m3template .a2ui-tabs__tab { padding: 10px 24px; border-radius: 8px; background-color: #E7E0EC; color: #49454F; font-size: 15px; -unity-text-align: middle-center; border-width: 0; }
.a2ui-skin--figma-m3template .a2ui-tabs__tab.a2ui-tabs__tab--active { background-color: #6750A4; color: #FFFFFF; }
.a2ui-skin--figma-m3template .a2ui-list__item { background-color: #E7E0EC; border-radius: 8px; padding: 16px; margin-bottom: 8px; border-left-width: 4px; border-left-color: #6750A4; border-left-style: solid; }
.a2ui-skin--figma-m3template .a2ui-chip { background-color: #E7E0EC; color: #1C1B1F; border-radius: 18px; padding: 8px 16px; font-size: 15px; border-width: 0; }
.a2ui-skin--figma-m3template .a2ui-chip:checked { background-color: #6750A4; color: #FFFFFF; }
.a2ui-skin--figma-m3template .a2ui-cabin { background-color: #E7E0EC; border-radius: 16px; padding: 24px 24px; }
.a2ui-skin--figma-m3template .a2ui-cabin__tag { background-color: #6750A4; color: #FFFFFF; border-radius: 8px; }